{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `gestion` queda fuera del include de arriba (`**/*.tsx`): es un proyecto
  // Vite con su propia config —jsx react-jsx, alias `@` a su `src`, tipos de
  // `import.meta.env`— y `next build` lo rompería. Su typecheck lo hace su
  // propio build (`tsc --noEmit` con gestion/tsconfig.json).
  "exclude": ["node_modules", "gestion"]
}
