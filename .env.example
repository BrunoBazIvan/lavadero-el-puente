# Copiá este archivo a `.env.local` solo si querés probar algo en local.
# En producción los valores se cargan en Vercel → Settings → Environment
# Variables, entorno Production.
#
# Todas son públicas: NEXT_PUBLIC_* termina dentro del HTML. Se incrustan
# en el build, así que después de cambiarlas hay que volver a deployar.

# ID de medición de Google Analytics 4 (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Project ID de Microsoft Clarity
NEXT_PUBLIC_CLARITY_ID=
# Dominio de producción: la analítica solo carga acá (ni localhost ni previews)
NEXT_PUBLIC_SITE_URL=https://www.lavaderoelpuente.com
# "opt-in" (nada se guarda hasta que la persona acepta) | "notice"
NEXT_PUBLIC_CONSENT_MODE=opt-in
