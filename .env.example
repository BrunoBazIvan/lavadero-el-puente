# Copiá este archivo a `.env.local` y completá los dos valores.
# Están en Supabase → Project Settings → API.
#
# La `anon key` es pública por diseño: lo que protege los datos son las
# políticas RLS de la base, no el secreto de esta clave.
#
# ⚠️ NUNCA pongas acá la `service_role` key. Todo lo que empieza con VITE_
# termina dentro del bundle que se descarga el navegador.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
